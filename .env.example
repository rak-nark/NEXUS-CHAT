# Nexus Chat — Variables de entorno

# Google Gemini API key (obtener gratis en https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu_api_key_aqui

# Modelo de Gemini (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Puerto del backend (default: 3001)
PORT=3001

# (Opcional) Stitch MCP — solo si usas el servidor MCP heredado
# STITCH_API_KEY=tu_stitch_key
